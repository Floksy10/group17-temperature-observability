    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "prometheus-config",
        "namespace": "temperature"
      },
      "data": {
        "prometheus.yml": "global:\n  scrape_interval: 5s\nscrape_configs:\n  - job_name: node\n    static_configs:\n      - targets: [\"node-exporter:9100\"]\n  - job_name: application\n    kubernetes_sd_configs:\n      - role: pod\n        namespaces:\n          names: [temperature]\n    relabel_configs:\n      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]\n        action: keep\n        regex: 'true'\n      - source_labels: [__meta_kubernetes_pod_phase]\n        action: keep\n        regex: Running\n      - source_labels: [__meta_kubernetes_pod_label_app]\n        target_label: job\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "temperature"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "serviceAccountName": "prometheus",
            "nodeSelector": {
              "kubernetes.io/hostname": "group17"
            },
            "securityContext": {
              "runAsUser": 65534,
              "runAsGroup": 65534
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.2.1",
                "args": [
                  "--config.file=/etc/prometheus/prometheus.yml",
                  "--storage.tsdb.path=/prometheus",
                  "--storage.tsdb.retention.time=7d",
                  "--storage.tsdb.retention.size=512MB"
                ],
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "memory": "384Mi",
                    "cpu": "500m"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/prometheus"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus-config"
                }
              },
              {
                "name": "data",
                "hostPath": {
                  "path": "/var/lib/docker/volumes/group17-temperature-observability_prometheus_data/_data",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "temperature"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "port": 9090,
            "targetPort": 9090,
            "nodePort": 3008
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "node-exporter",
        "namespace": "temperature"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "node-exporter"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "node-exporter"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "group17"
            },
            "containers": [
              {
                "name": "node-exporter",
                "image": "prom/node-exporter:v1.9.0",
                "args": [
                  "--path.rootfs=/host"
                ],
                "ports": [
                  {
                    "containerPort": 9100
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "root",
                    "mountPath": "/host",
                    "readOnly": true,
                    "mountPropagation": "HostToContainer"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "root",
                "hostPath": {
                  "path": "/",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "node-exporter",
        "namespace": "temperature"
      },
      "spec": {
        "selector": {
          "app": "node-exporter"
        },
        "ports": [
          {
            "port": 9100,
            "targetPort": 9100
          }
        ]
      }
    }
  ]
}
