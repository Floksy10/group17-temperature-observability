    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "gateway-config",
        "namespace": "temperature"
      },
      "data": {
        "nginx.conf": "worker_processes 1;\npid /tmp/nginx.pid;\nerror_log /dev/stderr warn;\nevents { worker_connections 2048; }\nhttp {\n  access_log off;\n  client_body_temp_path /tmp/client_body;\n  proxy_temp_path /tmp/proxy;\n  fastcgi_temp_path /tmp/fastcgi;\n  uwsgi_temp_path /tmp/uwsgi;\n  scgi_temp_path /tmp/scgi;\n  resolver 10.43.0.10 valid=2s ipv6=off;\n  upstream temperature_api {\n    zone temperature_api 64k;\n    server api-backend.temperature.svc.cluster.local:3003 resolve max_fails=1 fail_timeout=2s;\n    server api-reserve-backend.temperature.svc.cluster.local:3003 resolve backup max_fails=0;\n    keepalive 32;\n  }\n  server {\n    listen 8080;\n    location / {\n      proxy_pass http://temperature_api;\n      proxy_http_version 1.1;\n      proxy_set_header Connection \"\";\n      proxy_set_header Host $host;\n      proxy_connect_timeout 1s;\n      proxy_read_timeout 5s;\n      proxy_next_upstream error timeout http_502 http_503 http_504;\n      proxy_next_upstream_tries 5;\n      proxy_next_upstream_timeout 5s;\n      proxy_buffering on;\n    }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "gateway",
        "namespace": "temperature"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "gateway"
            },
            "annotations": {
              "configuration-hash": "5c18b64b4b3fbe4a00ca10e9466250ee7f3ef8b9f52898ed6ff9c7c12335df3f"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 10001
            },
            "nodeSelector": {
              "kubernetes.io/hostname": "group17"
            },
            "containers": [
              {
                "name": "gateway",
                "image": "nginx:1.28-alpine",
                "command": [
                  "sh",
                  "-c",
                  "ulimit -n 8192; exec nginx -g 'daemon off;'"
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "securityContext": {
                  "runAsUser": 10001,
                  "runAsNonRoot": true,
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "64Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 8080
                  },
                  "initialDelaySeconds": 3,
                  "timeoutSeconds": 2
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "gateway-config"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "16Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "autoscaling/v2",
