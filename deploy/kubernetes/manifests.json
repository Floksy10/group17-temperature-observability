                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 3003
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "livenessProbe": {
                  "tcpSocket": {
                    "port": 3003
                  },
                  "periodSeconds": 10
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 3003
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 30
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "16Mi"
                }
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "nick-client4"
            },
            "tolerations": [
              {
                "key": "role",
                "operator": "Equal",
                "value": "load",
                "effect": "NoSchedule"
