                    "value": "http://prometheus:9090"
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "runtime"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "400m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "256Mi"
                  }
                },
                "args": [
                  "uvicorn",
                  "app:app",
                  "--host",
                  "0.0.0.0",
                  "--port",
                  "3003",
                  "--workers",
                  "1",
                  "--loop",
                  "uvloop",
                  "--http",
                  "httptools",
                  "--no-access-log"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 3003
                  }
                ],
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "python",
                        "-c",
                        "import time; time.sleep(10)"
                      ]
